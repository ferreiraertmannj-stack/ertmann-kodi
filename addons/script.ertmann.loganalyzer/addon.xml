<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.ertmann.loganalyzer" name="Ertmann Log Analyzer" version="1.0.0" provider-name="Ertmann Tech">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Log file analyzer</summary>
        <description lang="en_GB">Reads and extracts errors from kodi.log for easy troubleshooting.</description>
        <platform>all</platform>
    </extension>
</addon>
