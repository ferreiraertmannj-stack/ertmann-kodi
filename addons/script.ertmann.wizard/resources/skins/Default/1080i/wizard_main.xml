<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">1</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="E5000000">white.png</texture>
        </control>
        
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>800</width>
            <height>600</height>
            
            <!-- Window Background -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>800</width>
                <height>600</height>
                <texture colordiffuse="FF1E1E1E">white.png</texture>
                <bordertexture border="4">dialog_border.png</bordertexture>
                <bordersize>4</bordersize>
            </control>
            
            <control type="label">
                <left>0</left>
                <top>40</top>
                <width>800</width>
                <height>50</height>
                <align>center</align>
                <label>Welcome to Ertmann Media Center</label>
                <font>font30_title</font>
                <textcolor>FFFFFFFF</textcolor>
            </control>
            
            <control type="label">
                <left>50</left>
                <top>120</top>
                <width>700</width>
                <height>200</height>
                <wrapmultiline>true</wrapmultiline>
                <align>center</align>
                <label>Please configure your system. Choose your language, connect to the network, and install the official repository updates.</label>
                <font>font15</font>
                <textcolor>FFBBBBBB</textcolor>
            </control>

            <!-- Buttons -->
            <control type="button" id="1">
                <left>250</left>
                <top>400</top>
                <width>300</width>
                <height>50</height>
                <label>Continue</label>
                <font>font15</font>
                <align>center</align>
            </control>
        </control>
    </controls>
</window>
