root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.xml]
indent_size = 4

[*.json]
indent_size = 4

[*.po]
indent_size = 4

[*.txt]
indent_size = 4

# Kodi C++ and CMake rules
[*.{cpp,h,cc,c,hpp}]
indent_style = space
indent_size = 2

[CMakeLists.txt,*.cmake]
indent_style = space
indent_size = 2
